<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Which VrfBridge build to reference: Release (5.0.2 stack, default) |
         Release-5.2 | Release-5.2-HLA4. Select: dotnet build -p:BridgeConfig=Release-5.2.
         Cloned verbatim from tools/CreateOne/CreateOne.csproj. -->
    <BridgeConfig Condition="'$(BridgeConfig)'==''">Release</BridgeConfig>
    <OutputPath Condition="'$(BridgeConfig)'!='Release'">bin\$(BridgeConfig)\</OutputPath>
    <IntermediateOutputPath Condition="'$(BridgeConfig)'!='Release'">obj\$(BridgeConfig)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\StackIdentity.cs" Link="StackIdentity.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VrfBridge">
      <HintPath>..\..\src\VrfBridge\build\$(BridgeConfig)\VrfBridge.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\VrfBridge\build\$(BridgeConfig)\Ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
