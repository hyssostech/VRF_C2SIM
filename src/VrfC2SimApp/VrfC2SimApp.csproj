<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- x64/win-x64: the bridge is a native x64 (/clr:netcore) assembly -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>VrfC2SimApp</RootNamespace>
    <AssemblyName>VrfC2SimApp</AssemblyName>
    <!-- Which VrfBridge build to reference: Release (5.0.2 stack, default) | Release-5.2 | Release-5.2-HLA4
         (src/VrfBridge/VrfBridge.vcxproj). Select with: dotnet build -p:BridgeConfig=Release-5.2 -->
    <BridgeConfig Condition="'$(BridgeConfig)'==''">Release</BridgeConfig>
    <!-- Non-default bridges build to their own tree (bin\Release-5.2\net10.0\win-x64\) so the
         5.0.2 deployment under bin\Release\ is never overwritten. -->
    <OutputPath Condition="'$(BridgeConfig)'!='Release'">bin\$(BridgeConfig)\</OutputPath>
    <IntermediateOutputPath Condition="'$(BridgeConfig)'!='Release'">obj\$(BridgeConfig)\</IntermediateOutputPath>
    <!-- CA2017 (logging template placeholder count/name must match the supplied arguments) is an
         ERROR, not a warning: a repeated named placeholder shifts every argument after it
         positionally (Microsoft.Extensions.Logging binds by position, not by name) and the SF4
         hold-refusal defect (VrfC2SimService.cs:3161, fixed alongside this change) proved that a
         mismatch here does not just garble a log line - it THROWS at the call site and can abort
         a dispatch before it completes. This is the second time this defect class has appeared
         this week; the compiler enforces it going forward. Only CA2017 is promoted - the six
         pre-existing documented warnings (4x CA2024, 2x CS8632) stay warnings. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA2017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The C++/CLI bridge (CopyLocal drops VrfBridge.dll beside the exe). -->
    <Reference Include="VrfBridge">
      <HintPath>..\VrfBridge\build\$(BridgeConfig)\VrfBridge.dll</HintPath>
    </Reference>
    <!-- The C2SIM .NET SDK. NOTE: relative path crosses OUT of the VRF_C2SIM
         submodule into the fork's SDK tree (dev/sdk-fixes, unpushed). A future
         step decouples this via a published SDK nuget. -->
    <ProjectReference Include="..\..\..\..\Library\CS\C2SIMSDK\C2SIMSDK\C2SIMSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IJW bootstrap next to the exe (a bare <Reference> does not copy it). -->
    <None Include="..\VrfBridge\build\$(BridgeConfig)\Ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- DEMO overlay, loaded when DOTNET_ENVIRONMENT=Demo (scripts/StartInterface52.ps1). -->
    <None Update="appsettings.Demo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The RTI rid the in-process bootstrap points RTI_RID_FILE at (MakRuntime.cs; Demo overlay
         RidFile is relative to the app directory). The rtiexec posture UG52 5.5.1 requires. -->
    <None Include="..\..\config\rid-501-rtiexec-min.mtl" Link="rid-501-rtiexec-min.mtl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
  </ItemGroup>

  <!-- ===================================================================================
       N3 (D7 harvest): WHICH COMMIT IS THIS BINARY?

       The runner manifest records `host.gitCommit` = the WORKING TREE's HEAD at run time,
       which is not the same question. Run D7's manifest said 9baddf9 while the deployed
       binaries were adca180: harmless that day (two doc commits apart, checked by hand
       afterwards) and exactly the field a harvest cannot check by itself. The build is the
       only thing that knows what it was built from, so it stamps it, the start-up banner
       prints it, and the runner reads it off the deployed file instead of off git.

       ROBUSTNESS, deliberately: git is not a build dependency. ContinueOnError + an exit-code
       test means a tree with no git, no repository or no HEAD builds exactly as before and
       stamps "unknown". The DIRTY flag is the load-bearing half - a binary built from an
       edited tree is NOT its commit, and saying "adca180" of it would be a false claim.
       IgnoreStandardErrorWarningFormat keeps git's stderr from being read as MSBuild warnings.
       ==================================================================================== -->
  <Target Name="StampGitIdentity" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=7 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low"
          StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHeadOut" />
      <Output TaskParameter="ExitCode" PropertyName="_GitHeadExit" />
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain --untracked-files=no"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low"
          StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirtyOut" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDirtyExit" />
    </Exec>
    <PropertyGroup>
      <BuildGitCommit Condition="'$(_GitHeadExit)'=='0' and '$(_GitHeadOut)'!=''">$(_GitHeadOut.Trim())</BuildGitCommit>
      <BuildGitCommit Condition="'$(BuildGitCommit)'==''">unknown (git did not answer)</BuildGitCommit>
      <BuildGitCommit Condition="'$(_GitDirtyExit)'=='0' and '$(_GitDirtyOut)'!=''">$(BuildGitCommit)+DIRTY</BuildGitCommit>
      <BuildStampUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildStampUtc>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildGitCommit</_Parameter1>
        <_Parameter2>$(BuildGitCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildStampUtc</_Parameter1>
        <_Parameter2>$(BuildStampUtc)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildBridgeConfig</_Parameter1>
        <_Parameter2>$(BridgeConfig)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
    <!-- ProductVersion on the deployed .exe/.dll, so the runner (and anyone with a file
         explorer) can read the commit WITHOUT starting the app. -->
    <PropertyGroup>
      <InformationalVersion>$(Version)+git.$(BuildGitCommit).$(BridgeConfig)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
